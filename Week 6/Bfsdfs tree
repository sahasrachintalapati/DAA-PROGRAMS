#include<bits/stdc++.h>
using namespace std;
void dfs(int node,vector<vector<int>>&adj,vector<bool>&visited)
{
	visited[node]=true;
	cout<<node<<" ";
	for(int nb:adj[node])
	if(!visited[nb]) dfs(nb,adj,visited);
}
void bfs(int start,vector<vector<int>>&adj,vector<bool>&visited)
{
	queue<int>q;
	q.push(start);
	visited[start]=true;
	while(!q.empty()){
		int node=q.front();
		q.pop();
		cout<<node<<" ";
		for(int nb:adj[node])
		{
			if(!visited[nb])
			{
				visited[nb]=true;
				q.push(nb);
			}
		}
	}
}
int main(){
	int n,m;
	cout<<"enter the number of vertices";
	cin>>n;
	cout<<"enter number of edges";
	cin>>m;
	vector<vector<int>>adj(n);
	cout<<"enter each edge as: u v \n";
	for(int i=0;i<m;i++)
	{
		int u,v;
		cin>>u>>v;
		adj[u].push_back(v);
		adj[v].push_back(u);
	}
	vector<bool>visitedDFS(n,false),visitedBFS(n,false);
	cout<<"dfs traversal:";
	for(int v=0;v<n;v++)
	if(!visitedDFS[v])dfs(v,adj,visitedDFS);
	cout<<"bfs traversal:";
	for(int v=0;v<n;v++)
	if(!visitedBFS[v])bfs(v,adj,visitedBFS);
	return 0;
}
