#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    int singleNumber(vector<int>& nums) {
        int result = 0;

        for (int x : nums) {
            result = result ^ x;
        }

        return result;
    }
};

int main() {
    Solution s;

    vector<int> nums = {4, 1, 2, 1, 2};

    cout << "Single number: " << s.singleNumber(nums);

    return 0;
}
