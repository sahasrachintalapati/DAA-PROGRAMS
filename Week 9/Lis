#include<bits/stdc++.h>
using namespace std;
int  lis(vector<int>&a){
	int n=a.size();
	vector<int>dp(n,1);
	for(int i=1;i<n;i++){
	for(int j=0;j<i;j++){
		if(a[j]<a[i]){
			dp[i]=max(dp[i],dp[j]+1);
		}
	}
	}
	 return *max_element(dp.begin(),dp.end());
}
 int main(){
 	int n;
 	cout<<"enter size:";
 	cin>>n;
	 vector<int>a(n);
	 cout<<"enter elements of array";
	 for(int i=0;i<n;i++){
	 	cin>>a[i];
	 }
	  cout<<"length of lis:"<<lis(a);
	  return 0;
}
