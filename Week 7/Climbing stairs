#include<bits/stdc++.h>
using namespace std;
int climbstairs(int n)
{
	if(n<=2)
	return n;
	int prev1=2;
	int prev2=1;
	for(int i=3;i<=n;i++)
	{
		int current=prev1+prev2;
		prev2=prev1;
		prev1=current;
	}
	return prev1;
}
  int main(){
  	int n;
  	cout<<"enter the value of n";
  	cin>>n;
  	cout<<"number of ways to climb stairs:"<<climbstairs(n);
  	return 0;
  }
